# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual envs
.venv/
venv/
env/

# Editor / OS / local agent settings
.vscode/
.idea/
.DS_Store
.claude/

# Build / generated output (regenerated by scripts/build_deploy_package.sh)
deploy_out/
build/
dist/
.build/
artifacts/
# CI writes the CycloneDX SBOM to the repository root before uploading it.
sbom.cdx.json

# Runtime data (created by middleware at runtime; do not commit)
*.sqlite3
*.log
/config/production.local.yaml
/packaging/secsgem_simulator/logs/

# Windows-absolute default paths (MiddlewarePaths in models.py) resolve as
# RELATIVE on macOS/Linux, so anything running with the shipped defaults creates
# ./C:/SECSGEM_EAP/... inside the repo. Tests must override paths to tmp_path.
/C:/

# Scratch
tmp/
*.tmp
/output/playwright/
/python-manager-*.msix
